# Общий секрет Spring ↔ ML (заголовок X-Internal-Token). Пустой токен = все вызовы получают 401
INTERNAL_TOKEN=
# Каталог с statements/*.csv и companies.csv (в контейнере /data — смонтируйте volume)
ML_DATA_DIR=/data
# БД бэкенда: операции компании берутся функцией get_operations_period (пусто — только CSV)
DATABASE_URL=
# Активная модель при первом старте (дальше выбор хранится в state и меняется через /ml/models/{v}/activate)
ML_MODEL_VERSION=lgbm_net-v2
# Воркеры прогноза: каждый ~600 МБ RAM и ~7 с на загрузку
ML_WORKERS=2
# Сколько запросов ждёт свободного воркера, дальше 429
ML_QUEUE_MAX=16
# Воркеры фоновых задач process/retrain
ML_JOB_WORKERS=1
ML_REQUEST_TIMEOUT=30
